LLM_PROVIDER=vllm
VLLM_BASE_URL=http://xxx.xxx.xxx.xxx:xxx/v1
VLLM_MODEL=xxx
VLLM_API_KEY=xxx
VLLM_MAX_TOKENS=xxx
VLLM_ENABLE_THINKING=xxx

OPENAI_API_KEY=...
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama (inactive)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://192.168.1.107:11434
